root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# shfmt reads the shell_* keys below.
[{*.sh,*.bash,PKGBUILD,*.install,*.hook.sh}]
indent_size = 2
shell_variant = bash
switch_case_indent = true

[*.qml]
indent_size = 4

[*.py]
indent_size = 4
