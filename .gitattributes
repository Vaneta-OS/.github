# Shell scripts, PKGBUILDs and configuration must keep LF endings, even on a
# Windows checkout with core.autocrlf=true.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ogg binary
*.oga binary
*.wav binary
*.flac binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.gz binary
*.xz binary
*.zst binary
*.iso binary
*.sig binary
*.gpg binary
